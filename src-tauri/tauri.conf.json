{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindowsPortManager",
  "version": "0.1.0",
  "identifier": "com.windowsportmanager.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WindowsPortManager",
        "width": 1220,
        "height": 760,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
